{
  "//": "design-system-kit 0.10.1 · the kit's own CI. Not a client file: it installs the toolchain the kit's tests run on (the Vite tested range's versions), and assemble.mjs lays the kit out as an app would have it.",
  "name": "design-system-kit-ci",
  "private": true,
  "type": "module",
  "scripts": {
    "assemble": "node assemble.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:app": "vitest run",
    "test:tool": "node --test ../tools/ds-setup.test.mjs ../tools/ds-upgrade.test.mjs",
    "test:fixture": "node app/scripts/__fixtures__/run.mjs",
    "test": "npm run assemble && npm run typecheck && npm run test:app && npm run test:tool && npm run test:fixture"
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@tailwindcss/cli": "4.3.3",
    "@tanstack/react-table": "8.21.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "date-fns": "4.4.0",
    "esbuild": "0.28.2",
    "jsdom": "28.1.0",
    "lucide-react": "1.49.0",
    "next-themes": "0.4.6",
    "react": "19.2.4",
    "react-day-picker": "10.0.2",
    "react-dom": "19.2.4",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
